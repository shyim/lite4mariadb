---
import { INSTALL_CMD } from '../lib/samples.js';
---
<button type="button" class="btn btn-primary btn-install" data-copy-install={INSTALL_CMD} aria-live="polite">
  <span>{INSTALL_CMD}</span>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-install]')) {
    const label = btn.querySelector('span')!;
    const cmd = btn.dataset.copyInstall!;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
      } catch {
        return;
      }
      label.textContent = 'copied';
      clearTimeout(timer);
      timer = setTimeout(() => { label.textContent = cmd; }, 1400);
    });
  }
</script>
