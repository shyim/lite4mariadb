---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---
<Base title="Shell — lite4mariadb" description="Run real MariaDB SQL in your browser tab. Nothing leaves the page." fixed>
  <main class="main">
    <Terminal />
  </main>
</Base>

<style>
  .main { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; }
  .main > :global(.term) { flex: 1; }
</style>
